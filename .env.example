DiscordSettings__BotToken=xxx
ASPNETCORE_ENVIRONMENT=Development

CorsSettings__AllowedUrls=http://localhost:5173,http://localhost:5500,http://localhost:4173,https://tunnel-url.com

DatabaseSettings__UserId=postgres
DatabaseSettings__Password=mysecretpassword
DatabaseSettings__Host=localhost
DatabaseSettings__Port=5430
DatabaseSettings__DatabaseName=ListenfyDb

SpotifySettings__ClientId=xxx
SpotifySettings__ClientSecret=xxx
SpotifySettings__ConnectUrl=https://tunnel-url.com/connect
SpotifySettings__ApiBaseUrl=https://api.spotify.com/v1
SpotifySettings__AccountsBaseUrl=https://accounts.spotify.com
